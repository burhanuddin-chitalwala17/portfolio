# Copy to .env.local for local development. In production, set these in Vercel → Settings → Environment Variables.
# Only ADMIN_PASSWORD is required; each block below switches on one feature.

# Admin login
ADMIN_PASSWORD=
# Any long random string. Signs admin session cookies and salts visitor IP hashes.
ADMIN_SESSION_SECRET=

# Database: documents, inbox, chat history, content versions. Any Postgres works.
# Supabase: Connect → Transaction pooler (port 6543).
DATABASE_URL=

# File storage: any S3-compatible service (Supabase Storage → S3 Connection, Cloudflare R2, AWS S3).
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# AI chat and resume → content drafts (also needs DATABASE_URL). All optional: providers, models and
# keys can be set in Admin → AI instead, where a saved key takes priority over these. Set a monthly
# spend limit on every key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Any other OpenAI-compatible provider
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
# Models used until something is saved in Admin → AI (both default to claude-opus-5-5).
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_CONTENT_MODEL=
# Encrypts keys saved in Admin → AI. Defaults to ADMIN_SESSION_SECRET; changing it means re-entering the keys.
SETTINGS_ENCRYPTION_KEY=
# Optional: GitHub access for the chat (repositories are chosen in Admin → Sources). A token saved
# there takes priority. Fine-grained, read-only Contents + Metadata, limited to the repos you share.
GITHUB_TOKEN=
GITHUB_USERNAME=
# Optional chat limits (defaults: 20 messages per visitor per hour, 300 per day overall).
CHAT_HOURLY_LIMIT_PER_VISITOR=
CHAT_DAILY_LIMIT=

# Optional: protects the daily keep-alive job. Vercel sends it automatically when set.
CRON_SECRET=
