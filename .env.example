# Copy to .env.local for local development. In production, set these in Vercel → Settings → Environment Variables.

# Admin login
ADMIN_PASSWORD=
# Any long random string; signs admin session cookies.
ADMIN_SESSION_SECRET=

# Postgres connection string (Supabase → Connect → Transaction pooler, port 6543).
DATABASE_URL=

# S3-compatible storage (Supabase → Storage → S3 Connection, or Cloudflare R2).
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Optional: protects the daily keep-alive job. Vercel sends it automatically when set.
CRON_SECRET=
