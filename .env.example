# Copy to .env.local for local development. In production, set these in Vercel → Settings → Environment Variables.
# Only ADMIN_PASSWORD is required; each block below switches on one feature.

# Admin login
ADMIN_PASSWORD=
# Any long random string. Signs admin session cookies and salts visitor IP hashes.
ADMIN_SESSION_SECRET=

# Database: documents, inbox, chat history, content versions. Any Postgres works.
# Supabase: Connect → Transaction pooler (port 6543).
DATABASE_URL=

# File storage: any S3-compatible service (Supabase Storage → S3 Connection, Cloudflare R2, AWS S3).
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# AI chat and resume → content drafts (also needs DATABASE_URL). Set a monthly spend limit on the key.
ANTHROPIC_API_KEY=
# Optional overrides. Both default to claude-opus-5-5; claude-haiku-5-5 makes the chat much cheaper.
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_CONTENT_MODEL=
# Optional chat limits (defaults: 20 messages per visitor per hour, 300 per day overall).
CHAT_HOURLY_LIMIT_PER_VISITOR=
CHAT_DAILY_LIMIT=

# Optional: protects the daily keep-alive job. Vercel sends it automatically when set.
CRON_SECRET=
